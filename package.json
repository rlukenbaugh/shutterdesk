{
  "name": "shutterdesk",
  "version": "1.0.0",
  "description": "ShutterDesk — Windows Screenshot Capture & Screen Recorder",
  "author": "ShutterDesk Studio",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.shutterdesk.capture",
    "productName": "ShutterDesk",
    "copyright": "Copyright © 2026 ShutterDesk Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "publisherName": "ShutterDesk Studio"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "shortcutName": "ShutterDesk",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}