{
  "name": "shutterdesk",
  "version": "1.1.0",
  "description": "ShutterDesk — Windows Screenshot Capture & Screen Recorder",
  "author": "ShutterDesk Studio",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/region-preload.cjs && node --check renderer/app.js && node --check renderer/region.js",
    "generate:icons": "node scripts/generate-icons.mjs",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.shutterdesk.capture",
    "productName": "ShutterDesk",
    "copyright": "Copyright © 2026 ShutterDesk Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "shortcutName": "ShutterDesk",
      "uninstallDisplayName": "ShutterDesk",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
